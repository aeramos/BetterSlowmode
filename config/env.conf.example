# Example env.conf

# Discord bot token used for the connection.
BOT_TOKEN=qwertyuiop1234567890

# PostgreSQL connection string that will be used by Sequelize.
# Format: postgresql://[user[:password]@][networklocation][:port][/dbname][?param1=value1&...]
DATABASE_URL=postgresql://database_user:database_password@127.0.0.1:5432/database_name

# Discord chat prefix to issue a command to the bot and used in the bot's Discord status message. Usually a symbol, but
# can be any string. In the future, Slash Commands wlll be the primary interface with the bot instead.
#
# If left undefined, the status message will say to use the Slash Command.
PREFIX=%

# Discord invite code for the support server. This is used to make an invite link for the Info command.
SUPPORT_CODE=JUE8keP
